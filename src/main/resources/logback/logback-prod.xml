<?xml version="1.0" encoding="UTF-8"?>
<!-- logback/logback-prod.xml -->
<configuration>
    <!-- 공통 변수 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="[%d{yyyy-MM-dd HH:mm:ss,Asia/Seoul}] [prod] [%thread] [trace:%X{traceId:-}, span:%X{spanId:-}, req:%X{requestId:-}] %-5level [%C.%M:%L] - %msg%n"/>
    <property name="appName" value="${springAppName:-${spring.application.name:-gmg}}"/>
    <!-- JSON 콘솔 출력 (Promtail이 파싱) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- 타임스탬프 포맷 -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <timeZone>Asia/Seoul</timeZone>

            <!-- 기본 필드 제공자 -->
            <provider class="net.logstash.logback.composite.loggingevent.LoggingEventPatternJsonProvider">
                <pattern>
                    {
                    "app": "${appName}",
                    "env": "production",
                    "host": "${HOSTNAME:-unknown}",
                    "level": "%level",
                    "logger": "%logger{36}",
                    "thread": "%thread",
                    "spanId": "%X{spanId:-}",
                    "msg": "%message",
                    "class": "%C{1}",
                    "method": "%M"
                    }
                </pattern>
            </provider>

            <!-- MDC에서 id가져오기 -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>

            <!-- 스택 트레이스를 문자열로 포함 -->
            <includeStackTrace>true</includeStackTrace>

            <!-- caller 정보 포함 (성능 영향 있으므로 필요시만) -->
            <includeCallerData>false</includeCallerData>

            <!-- 컨텍스트 이름 제외 (불필요한 필드 제거) -->
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <!-- 비동기 처리 -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE_JSON"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock>
    </appender>

    <!-- SQL 전체 출력은 WARN 이상만 -->
    <logger name="org.hibernate.SQL" level="WARN" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <logger name="org.hibernate.orm.jdbc.bind" level="WARN" additivity="false"/>

    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <logger name="org.springframework.web" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <!-- 외부 라이브러리 -->
    <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>
